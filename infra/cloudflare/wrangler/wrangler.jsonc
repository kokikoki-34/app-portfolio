{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-proxy",
	"vars": {
		"ENV": "main",
		"PROXY_TARGET": "https://app-portfolio-proxy-442469161656.asia-northeast1.run.app"
	},
	"env": {
		"dev": {
			"name": "cloudflare-proxy-dev",
			"vars": {
				"ENV": "dev",
				"PROXY_TARGET": "https://app-portfolio-proxy-dev-442469161656.asia-northeast1.run.app"
			},
			"routes": [
				{
					"pattern": "dev.kokiyasui.com/*",
					"zone_name": "kokiyasui.com"
				}
			],
			"observability": {
				"enabled": false,
				"logs": {
					"enabled": false
				}
			}
		}
	},
	"main": "src/index.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "kokiyasui.com/*",
			"zone_name": "kokiyasui.com"
		}
	],
}